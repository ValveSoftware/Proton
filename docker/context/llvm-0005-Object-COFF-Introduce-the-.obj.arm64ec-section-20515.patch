+# CHECK-NEXT:     Section {
+# CHECK-NEXT:       Number: 1
+# CHECK-NEXT:       Name: .data (2E 64 61 74 61 00 00 00)
+# CHECK-NEXT:       VirtualSize: 0x0
+# CHECK-NEXT:       VirtualAddress: 0x0
+# CHECK-NEXT:       RawDataSize: 4
